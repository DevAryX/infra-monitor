# Infra Monitor runtime configuration example
# Copy this file to docker/runtime.env before running the stack.

INFRA_MONITOR_CPU_THRESHOLD=70
INFRA_MONITOR_MEMORY_THRESHOLD=70
INFRA_MONITOR_DISK_THRESHOLD=70
INFRA_MONITOR_MAX_LOG_SIZE=50000

INFRA_MONITOR_SYSTEM_LOG=/app/logs/system_report.log
INFRA_MONITOR_ERROR_LOG=/app/logs/error.log
INFRA_MONITOR_METRICS_DIR=/app/metrics

# Optional S3 upload configuration.
# Leave the bucket empty to disable uploads.
INFRA_MONITOR_S3_BUCKET=
INFRA_MONITOR_S3_KEY=system_report.log
